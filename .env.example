# Stripe server-only credential. In Vercel, prefer the native Stripe integration
# so this is provisioned without copying a secret into source or chat.
STRIPE_SECRET_KEY=

# Required for live Stripe only. Sandbox validation uses the locked test Price IDs
# in src/lib/offers.ts when these variables are absent.
STRIPE_PRICE_AUDIT_90_DAY=
STRIPE_PRICE_CONTINUOUS_MONITOR=

# Supabase values. Vercel Marketplace syncs these automatically for connected projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET is intentionally not an environment variable.
# Reqovr reads it server-side from Supabase Vault through a service-role-only RPC.
# Checkout/Portal origins are derived from the incoming request, and billing-cookie
# signing is domain-separated from SUPABASE_SECRET_KEY, so APP_URL and a second
# application signing secret are not required.
