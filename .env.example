# Stripe server-only credential. In Vercel, prefer the native Stripe integration
# so this is provisioned without copying a secret into source or chat.
STRIPE_SECRET_KEY=

# Required for live Stripe. Continuous Monitor is currently early access only,
# but its compatibility Price ID may remain configured for historical webhook parsing.
STRIPE_PRICE_AUDIT_90_DAY=
STRIPE_PRICE_CONTINUOUS_MONITOR=

# Supabase values. Vercel Marketplace syncs these automatically for connected projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET is intentionally not an environment variable.
# BillGuarded reads it server-side from Supabase Vault through a service-role-only RPC.
# Production redirect origins are pinned to https://billguarded.com; preview/local
# origins use the incoming request origin. Billing-cookie signing is domain-separated
# from SUPABASE_SECRET_KEY, so a second application signing secret is not required.
