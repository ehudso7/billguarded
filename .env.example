# Public application origin, no trailing slash.
APP_URL=http://localhost:3000

# Stripe server-only credentials. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs created in the same Stripe account as STRIPE_SECRET_KEY.
STRIPE_PRICE_AUDIT_90_DAY=
STRIPE_PRICE_CONTINUOUS_MONITOR=

# Supabase browser-safe values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase backend secret (prefer sb_secret_... for new projects).
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# 32+ byte random value used only to sign the temporary billing-management cookie.
APP_SIGNING_SECRET=
